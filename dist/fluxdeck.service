[Unit]
Description=FluxDeck: Stream Deck daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/fluxdeck
Restart=on-failure
RestartSec=2
# Apps launched from the deck must survive a restart of the daemon.
KillMode=process

[Install]
WantedBy=graphical-session.target
